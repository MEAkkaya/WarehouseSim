[gd_resource type="Resource" script_class="EventData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/security_upgrade_event.gd" id="2_effect"]

[resource]
script = ExtResource("1_event")
id = &"security_upgrade"
title = "Security Upgrade"
description = "Lasers have been installed throughout the warehouse. Crouch, jump or climb over the shelves. Touch a beam - with yourself or your box - and the alarm sounds."
effect_script = ExtResource("2_effect")
