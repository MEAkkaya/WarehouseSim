[gd_resource type="Resource" script_class="EventData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/event_data.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/events/low_gravity_event.gd" id="2_effect"]

[resource]
